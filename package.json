{
  "name": "truthbounty-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node api.js && next dev",
    "verify-artifacts": "node scripts/verify-artifacts.mjs",
    "verify-performance-budgets": "node scripts/verify-performance-budgets.mjs",
    "test:production-smoke": "node scripts/production-smoke.mjs",
    "test:production-smoke:unit": "node --test scripts/__tests__/production-smoke.test.mjs",
    "verify-accessibility": "node scripts/verify-accessibility.mjs",
    "prebuild": "node scripts/verify-artifacts.mjs && node scripts/verify-production-boundaries.mjs source && node scripts/verify-accessibility.mjs",
    "build": "node api.js && next build",
    "postbuild": "node scripts/verify-production-boundaries.mjs bundle && node scripts/verify-performance-budgets.mjs && node scripts/verify-staging-smoke.mjs",
    "start": "node api.js && next start",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:a11y": "jest --runInBand src/__tests__/accessibility",
    "verify:accessibility": "node scripts/verify-accessibility.mjs",
    "verify:staging-smoke": "node scripts/verify-staging-smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-query-devtools": "5.104.0",
    "@wagmi/core": "3.6.5",
    "@worldcoin/idkit": "4.3.0",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "viem": "2.56.9",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.1",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-onboarding": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/postcss": "4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/node": "26",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-storybook": "10.6.0",
    "jest": "30.5.2",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "30.5.2",
    "msw": "^3.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "storybook": "^10.6.0",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.22.0"
}
